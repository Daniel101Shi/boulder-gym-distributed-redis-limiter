    {
      "id": "30hPg9rJXQwNMERgoYf7o",
      "type": "text",
      "x": 1422.1215505804314,
      "y": 867.7816383611308,
      "width": 382.2236328125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "sjxOSv5D7KQK6BAMXym5p"
      ],
      "frameId": null,
      "index": "b1h",
      "roundness": null,
      "seed": 5593036,
      "version": 756,
      "versionNonce": 299047116,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785616165848,
      "link": null,
      "locked": false,
      "text": "In Redis cluster, always 16384 partitions fodata",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In Redis cluster, always 16384 partitions fodata",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "S2FSRujbYOy93nzyrEWHl",
      "type": "text",
      "x": 1426.834666614952,
      "y": 901.2225165236322,
      "width": 495.0777587890625,
      "height": 200.6587219098446,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "sjxOSv5D7KQK6BAMXym5p"
      ],
      "frameId": null,
      "index": "b1i",
      "roundness": null,
      "seed": 1173388876,
      "version": 2658,
      "versionNonce": 73605580,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785616184923,
      "link": null,
      "locked": false,
      "text": "- Take a key, hash it to determine its bucket\n    - keys can be config with a \"hashtag\" to specify which part\nof it should be hashed\n\n- Cluster info is gossiped between Redis nodes\n    - clients may cache cluster info\n    - If client request is sent to wrong Redis node, it responds\nwith right one to contact\n\n- Transactions may only operate on keys within same bucket",
      "fontSize": 16.052697752787566,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Take a key, hash it to determine its bucket\n    - keys can be config with a \"hashtag\" to specify which part\nof it should be hashed\n\n- Cluster info is gossiped between Redis nodes\n    - clients may cache cluster info\n    - If client request is sent to wrong Redis node, it responds\nwith right one to contact\n\n- Transactions may only operate on keys within same bucket",
      "autoResize": true,
      "lineHeight": 1.25
    },
