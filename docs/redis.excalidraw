      "isDeleted": false,
      "boundElements": null,
      "updated": 1785614332788,
      "link": null,
      "locked": false,
      "text": "Batch:\n- pessimistic looking\n- queues and atomically executes a batch of commands sequentially\n\nWatch:\n- optimistic looking\n- monitors keys before transaction, aborts if another client modifies those keys",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Batch:\n- pessimistic looking\n- queues and atomically executes a batch of commands sequentially\n\nWatch:\n- optimistic looking\n- monitors keys before transaction, aborts if another client modifies those keys",
      "autoResize": true,
      "lineHeight": 1.25
    },
