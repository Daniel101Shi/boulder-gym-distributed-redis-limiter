    {
      "id": "kpPd2JKjF1vo1M1Lbrp_F",
      "type": "text",
      "x": 331.63148109795475,
      "y": 609.2884822120009,
      "width": 413.7596435546875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "rYsBlE2odnlB4rqMJD-mH"
      ],
      "frameId": null,
      "index": "b1AV",
      "roundness": null,
      "seed": 202188492,
      "version": 373,
      "versionNonce": 1591741812,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785614128242,
      "link": null,
      "locked": false,
      "text": "All policies have two classes\n- All: consider all keys\n- Volatile: consider keys with ttl\n\nLRU (default reccomended)\n- Use if theres a few keys that get majority of load\nLFU\nRandom\nTTL - key with shortest remaining TTL\n- use if TTL logic is really good",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "All policies have two classes\n- All: consider all keys\n- Volatile: consider keys with ttl\n\nLRU (default reccomended)\n- Use if theres a few keys that get majority of load\nLFU\nRandom\nTTL - key with shortest remaining TTL\n- use if TTL logic is really good",
      "autoResize": true,
      "lineHeight": 1.25
    },
